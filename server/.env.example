# Copy to .env on the local store server. Never commit the real .env file.
NODE_ENV=production
PORT=4000
APP_BASE_URL=https://melat.local
COOKIE_SECURE=true
DATABASE_URL=postgresql://melat_app:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/melat
OWNER_USERNAME=owner
OWNER_FULL_NAME=Melat Owner
OWNER_INITIAL_PASSWORD=REPLACE_WITH_A_UNIQUE_16_PLUS_CHARACTER_PASSWORD

DATABASE_SSL=false
DB_POOL_MAX=5

# Backup operations (set the public age recipient and an independent UNC/offsite directory)
BACKUP_AGE_RECIPIENT=
BACKUP_OFFSITE_DIRECTORY=

# Restore drill: use a PostgreSQL administrator URL and a separately stored age identity.
DATABASE_ADMIN_URL=
BACKUP_AGE_IDENTITY_FILE=
