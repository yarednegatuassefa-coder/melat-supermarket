# Local development template. Production setup creates the root .env via scripts/setup-local-melat.ps1.
# Never commit real credentials.
NODE_ENV=development
PORT=4000
BIND_HOST=127.0.0.1
TRUST_PROXY=0
COOKIE_SECURE=false
DATABASE_URL=postgresql://melat_app:CHANGE_ME@localhost:5432/melat
DATABASE_SSL=false
DB_POOL_MAX=5
APP_BASE_URL=http://localhost:5173

# Only needed for the one-time owner bootstrap. Remove after bootstrap.
OWNER_USERNAME=owner
OWNER_FULL_NAME=Melat Owner
OWNER_INITIAL_PASSWORD=REPLACE_WITH_UNIQUE_16_PLUS_CHARACTER_PASSWORD
